@model CityAlert.Models.AdminPanelViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-header-ca">Панель адміністратора</h1>

        <form asp-controller="Events" asp-action="ClearCache" method="post" onsubmit="return confirm('Ви впевнені, що хочете очистити кеш стрічки подій?')">
            <button type="submit" class="btn btn-ca-danger">
                Очистити кеш Redis
            </button>
        </form>
    </div>

    <div class="row mb-5">
        <div class="col-md-4">
            <div class="card card-ca text-center p-3">
                <div class="card-body">
                    <h5 class="text-muted">Активних подій</h5>
                    <h2 class="display-4 fw-bold" style="color: var(--ca-blue)">@Model.TotalActiveEvents</h2>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card card-ca">
                <div class="card-header">Підписки по районах</div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var dist in Model.SubscriptionsByDistrict)
                        {
                            <div class="col-6 col-sm-4 mb-2">
                                <div class="p-2 border rounded bg-light">
                                    <small class="d-block text-muted">@dist.DistrictName</small>
                                    <strong>@dist.Count підписників</strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-ca">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Усі події міста</span>
            <a asp-action="CreateEvents" class="btn btn-sm btn-light"> + Створити нову</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Дата</th>
                            <th>Назва</th>
                            <th>Район</th>
                            <th>Статус</th>
                            <th class="text-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model.AllEvents)
                        {
                            <tr>
                                <td>@ev.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <strong>@ev.Title</strong> <br />
                                    <small class="text-muted">@ev.Category</small>
                                </td>
                                <td><span class="badge bg-secondary">@ev.District.Name</span></td>
                                <td>
                                    @if (ev.IsActive)
                                    {
                                        <span class="badge bg-success">Активна</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">Деактивована</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a href="#" class="btn btn-sm btn-outline-primary">Редагувати</a>
                                        <button type="button" class="btn btn-sm btn-outline-danger">Видалити</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .table-responsive {
            border-radius: 0 0 12px 12px;
        }
        .table thead th {
            border-top: none;
            color: var(--ca-grey);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
    </style>
}