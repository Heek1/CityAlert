@model CityAlert.Models.AdminPanelViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h1 class="page-header-ca mb-0">Панель адміністратора</h1>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Districts" asp-action="Index" class="btn btn-ca-outline">Керування районами</a>
            <a asp-controller="Subscriptions" asp-action="Manage" class="btn btn-ca-outline">Керування підписками</a>
            <form asp-controller="Events" asp-action="ClearCache" method="post" onsubmit="return confirm('Ви впевнені, що хочете очистити кеш стрічки подій?')">
                <button type="submit" class="btn btn-ca-danger">
                    Очистити кеш Redis
                </button>
            </form>
        </div>
    </div>

    <div class="row mb-5 g-4">
        <div class="col-md-4">
            <div class="card card-ca text-center p-3 h-100">
                <div class="card-body">
                    <h5 class="text-muted">Активних подій</h5>
                    <h2 class="display-4 fw-bold" style="color: var(--ca-blue)">@Model.TotalActiveEvents</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-ca text-center p-3 h-100">
                <div class="card-body">
                    <h5 class="text-muted">Усього підписок</h5>
                    <h2 class="display-4 fw-bold" style="color: var(--ca-red)">@Model.TotalSubscriptions</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-ca text-center p-3 h-100">
                <div class="card-body">
                    <h5 class="text-muted">Унікальних підписників</h5>
                    <h2 class="display-4 fw-bold" style="color: var(--ca-yellow)">@Model.UniqueSubscribers</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5 g-4">
        <div class="col-lg-12">
            <div class="card card-ca">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span>Підписки по районах</span>
                    <a asp-controller="Subscriptions" asp-action="Manage" class="btn btn-sm btn-light">Відкрити повне керування</a>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var dist in Model.SubscriptionsByDistrict)
                        {
                            <div class="col-6 col-sm-4 col-xl-3 mb-2">
                                <div class="p-2 border rounded bg-light h-100">
                                    <small class="d-block text-muted">@dist.DistrictName</small>
                                    <strong>@dist.Count підписників</strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-ca">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Усі події міста</span>
            <a asp-action="CreateEvents" class="btn btn-sm btn-light"> + Створити нову</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Дата</th>
                            <th>Назва</th>
                            <th>Район</th>
                            <th>Статус</th>
                            <th class="text-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model.AllEvents)
                        {
                            <tr>
                                <td>@ev.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <strong>@ev.Title</strong> <br />
                                    <small class="text-muted">@ev.Category</small>
                                </td>
                                <td><span class="badge bg-secondary">@ev.District.Name</span></td>
                                <td>
                                    @if (ev.IsActive)
                                    {
                                        <span class="badge bg-success">Активна</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">Деактивована</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-controller="Events" asp-action="Edit" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-primary">Редагувати</a>
                                        <form asp-controller="Events" asp-action="Delete" asp-route-id="@ev.Id" method="post" onsubmit="return confirm('Видалити подію «@ev.Title»?')" style="display:inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .table-responsive {
            border-radius: 0 0 12px 12px;
        }
        .table thead th {
            border-top: none;
            color: var(--ca-grey);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        <style >
        .btn {
            border-radius: 10px;
            font-weight: 500;
            padding: 8px 16px;
            transition: all 0.25s ease;
        }

        .btn-ca-outline {
            border: 2px solid #3b82f6;
            color: #3b82f6;
            background-color: transparent;
        }

            .btn-ca-outline:hover {
                background-color: #3b82f6;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(59, 130, 246, 0.3);
            }

        .btn-ca-danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            border: none;
            color: white;
        }

            .btn-ca-danger:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(239, 68, 68, 0.4);
            }

        .btn-sm {
            border-radius: 8px;
            padding: 6px 12px;
        }

        .btn-outline-primary {
            border: 2px solid #3b82f6;
            color: #3b82f6;
        }

            .btn-outline-primary:hover {
                background-color: #3b82f6;
                color: white;
                transform: scale(1.05);
            }

        .btn-outline-danger {
            border: 2px solid #ef4444;
            color: #ef4444;
        }

            .btn-outline-danger:hover {
                background-color: #ef4444;
                color: white;
                transform: scale(1.05);
            }

        .btn-light {
            background-color: #f3f4f6;
            border: none;
            color: #374151;
        }

            .btn-light:hover {
                background-color: #e5e7eb;
                transform: translateY(-1px);
            }

        .btn-group .btn {
            border-radius: 8px !important;
            margin-left: 4px;
        }

        .btn:active {
            transform: scale(0.97);
            box-shadow: none;
        }
    </style>
    </style>
}
