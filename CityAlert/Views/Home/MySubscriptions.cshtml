@model IEnumerable<CityAlert.Models.Subscription>
@{
    ViewData["Title"] = "Мої підписки";
}

<div class="hero-card mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <h1 class="page-header-ca">Мої підписки</h1>
            <p class="page-subtitle">Райони, для яких увімкнено персональні сповіщення.</p>
        </div>
        <div class="col-lg-4">
            <div class="quick-links justify-content-lg-end">
                <a asp-controller="Home" asp-action="Index" class="btn btn-ca-light">Головна</a>
                <a asp-controller="Events" asp-action="Index" class="btn btn-ca-outline">Події</a>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card-ca empty-state">Підписок ще немає.</div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card-ca event-card">
                    <h5 class="fw-bold">@item.District.Name</h5>
                    <p class="event-description mb-0">Для цього району будуть відображатися персональні сповіщення.</p>
                </div>
            </div>
        }
    </div>
}