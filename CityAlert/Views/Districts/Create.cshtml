@model CityAlert.Models.District
@{
    ViewData["Title"] = "Створення району";
}

<div class="hero-card mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <h1 class="page-header-ca">Створення нового району</h1>
            <p class="page-subtitle">Введіть назву нового району міста.</p>
        </div>
        <div class="col-lg-4">
            <div class="quick-links justify-content-lg-end">
                <a asp-action="Index" class="btn btn-ca-light">До списку районів</a>
                <a asp-controller="Home" asp-action="AdminPanel" class="btn btn-ca-outline">Адмін панель</a>
            </div>
        </div>
    </div>
</div>

<div class="form-shell">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 border-0 mb-4"></div>

        <div class="row g-4">
            <div class="col-lg-6">
                <label asp-for="Name" class="form-label">Назва району</label>
                <input asp-for="Name" class="form-control"
                    placeholder="Введіть назву району" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
        </div>

        <div class="quick-links mt-4">
            <button type="submit" class="btn btn-ca-primary">Створити район</button>
            <a asp-action="Index" class="btn btn-ca-light">Скасувати</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
