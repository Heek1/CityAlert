@model IEnumerable<CityAlert.Models.Event>
@{
ViewData["Title"] = "Події";
var criticalEvents = Model.Where(e => e.Severity == CityAlert.Models.SeverityLevel.Critical).ToList();
var normalEvents = Model.Where(e => e.Severity != CityAlert.Models.SeverityLevel.Critical).ToList();
}

@if (TempData["SuccessMessage"] is string successMessage)
{
<div class="alert alert-success rounded-4 border-0 shadow-sm mb-4">@successMessage</div>
}

<div class="hero-card mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <h1 class="page-header-ca">Стрічка подій міста</h1>
            <p class="page-subtitle">
                Перегляд усіх активних міських подій з розподілом за важливістю, районом та категорією.
            </p>
        </div>
        <div class="col-lg-4">
            <div class="quick-links justify-content-lg-end">
                <a asp-controller="Home" asp-action="Index" class="btn btn-ca-light">Головна</a>
                <a asp-controller="Home" asp-action="EventMap" class="btn btn-ca-outline">Мапа подій</a>
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("moderator"))
                {
                <a asp-action="Create" class="btn btn-ca-primary">Створити подію</a>
                }
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
<div class="card-ca empty-state">Наразі активних подій немає.</div>
}
else
{
@if (criticalEvents.Any())
{
<div class="section-head mt-1">
    <div>
        <h2 class="page-header-ca" style="font-size:1.8rem;">Термінові повідомлення</h2>
        <p class="page-subtitle">Події, які потребують першочергової уваги.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    @foreach (var ev in criticalEvents)
    {
    <div class="col-12">
        <div class="card-ca event-card critical-card">
            <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
                <div>
                    <h4 class="fw-bold mb-2">@ev.Title</h4>
                    <div class="event-meta mt-0">
                        <span class="badge-soft badge-soft-red">Критично</span>
                        <span class="badge-soft badge-soft-dark">@ev.District?.Name</span>
                        <span class="badge-soft badge-soft-blue">@ev.Category</span>
                        <span class="badge-soft badge-soft-green">@ev.StartDate.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                </div>
                <div class="text-end footer-note">Створено: @ev.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
            </div>
            <p class="event-description mt-3 mb-0">@ev.Description</p>
        </div>
    </div>
    }
</div>
}

<div class="section-head">
    <div>
        <h2 class="page-header-ca" style="font-size:1.8rem;">Усі інші активні події</h2>
        <p class="page-subtitle">Оголошення з інформаційним та попереджувальним рівнем важливості.</p>
    </div>
</div>

<div class="row g-4">
    @foreach (var ev in normalEvents)
    {
    <div class="col-md-6 col-xl-4">
        <div class="card-ca event-card">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <h5 class="mb-0 fw-bold">@ev.Title</h5>
                @if (ev.Severity == CityAlert.Models.SeverityLevel.Warning)
                {
                <span class="badge-soft badge-soft-yellow">Увага</span>
                }
                else
                {
                <span class="badge-soft badge-soft-blue">Інфо</span>
                }
            </div>
            <p class="event-description text-clamp-3 mt-3 mb-0">@ev.Description</p>
            <div class="event-meta">
                <span class="badge-soft badge-soft-blue">@ev.Category</span>
                <span class="badge-soft badge-soft-dark">@ev.District?.Name</span>
                <span class="badge-soft badge-soft-green">@ev.StartDate.ToString("dd.MM.yyyy HH:mm")</span>
            </div>
        </div>
    </div>
    }
</div>
}
