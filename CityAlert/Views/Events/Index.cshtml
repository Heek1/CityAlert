@model IEnumerable<CityAlert.Models.Event>
@{
    ViewData["Title"] = "Стрічка подій";
    var criticalEvents = Model.Where(e => e.Severity == CityAlert.Models.SeverityLevel.Critical);
    var otherEvents = Model.Where(e => e.Severity != CityAlert.Models.SeverityLevel.Critical);
}

<div class="container mt-4">
    <h1 class="page-header-ca mb-4">Актуальні події міста</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info card-ca">
            Наразі немає активних подій.
        </div>
    }
    else
    {
        @if (criticalEvents.Any())
        {
            <div class="critical-section mb-5">
                <h4 class="text-danger fw-bold mb-3"> ТЕРМІНОВІ ПОВІДОМЛЕННЯ</h4>
                <div class="row">
                    @foreach (var ev in criticalEvents)
                    {
                        <div class="col-12 mb-3">
                            <div class="card card-ca border-danger shadow-sm" style="border-left: 5px solid var(--ca-red) !important;">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <h5 class="card-title text-danger fw-bold">@ev.Title</h5>
                                        <span class="badge bg-danger">Критично</span>
                                    </div>
                                    <p class="card-text">@ev.Description</p>
                                    <div class="text-muted small">
                                         @ev.District?.Name |  @ev.CreatedAt.ToString("g")
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="row">
            @foreach (var ev in otherEvents)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card card-ca h-100 hov-card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <small>@ev.Category</small>
                            @if (ev.Severity == CityAlert.Models.SeverityLevel.Warning)
                            {
                                <span class="badge bg-warning text-dark">Увага</span>
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@ev.Title</h5>
                            <p class="card-text text-truncate-3">@ev.Description</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge rounded-pill bg-light text-dark border">
                                    @ev.District?.Name
                                </span>
                                <small class="text-muted">@ev.CreatedAt.ToString("dd.MM")</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .text-truncate-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .hov-card {
        transition: transform 0.2s;
    }

        .hov-card:hover {
            transform: translateY(-5px);
        }
</style>